# ------------------------------------------------------------------------------
# Oprino Web Dashboard (Next.js 15) - Production Dockerfile (Multi-stage)
# ------------------------------------------------------------------------------

FROM node:22-alpine AS builder

WORKDIR /app

RUN npm install -g pnpm@11.22.0

# Copy workspace package manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/config-typescript packages/config-typescript/
COPY packages/config-eslint packages/config-eslint/
COPY packages/tokens packages/tokens/
COPY packages/contracts packages/contracts/
COPY apps/web apps/web/

# Install all dependencies
RUN pnpm install --frozen-lockfile

# Build tokens, contracts, and Next.js web application
RUN pnpm --filter @oprino/tokens build
RUN pnpm --filter @oprino/contracts build
RUN pnpm --filter @oprino/web build

# ------------------------------------------------------------------------------
# Production Runner Stage
# ------------------------------------------------------------------------------
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

RUN npm install -g pnpm@11.22.0

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/config-typescript packages/config-typescript/
COPY packages/config-eslint packages/config-eslint/
COPY --from=builder /app/packages/tokens /app/packages/tokens/
COPY --from=builder /app/packages/contracts /app/packages/contracts/
COPY --from=builder /app/apps/web /app/apps/web/

RUN pnpm install --prod --frozen-lockfile

USER node

EXPOSE 3000

CMD ["node", "apps/web/node_modules/next/dist/bin/next", "start", "apps/web"]

# ------------------------------------------------------------------------------
# Oprino Background Worker - Production Dockerfile (Multi-stage)
# ------------------------------------------------------------------------------

FROM node:22-alpine AS builder

WORKDIR /app

RUN npm install -g pnpm@11.22.0

# Copy workspace package manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/config-typescript packages/config-typescript/
COPY packages/config-eslint packages/config-eslint/
COPY packages/tokens packages/tokens/
COPY packages/contracts packages/contracts/
COPY packages/database packages/database/
COPY services/worker services/worker/

# Install all dependencies
RUN pnpm install --frozen-lockfile

# Generate contracts and build worker
RUN pnpm --filter @oprino/tokens build
RUN pnpm --filter @oprino/contracts build
RUN pnpm --filter @oprino/database build
RUN pnpm --filter @oprino/worker build

# ------------------------------------------------------------------------------
# Production Runner Stage
# ------------------------------------------------------------------------------
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

RUN npm install -g pnpm@11.22.0

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/config-typescript packages/config-typescript/
COPY packages/config-eslint packages/config-eslint/
COPY --from=builder /app/packages/tokens /app/packages/tokens/
COPY --from=builder /app/packages/contracts /app/packages/contracts/
COPY --from=builder /app/packages/database /app/packages/database/
COPY --from=builder /app/services/worker /app/services/worker/

# Install only production dependencies
RUN pnpm install --prod --frozen-lockfile

USER node

CMD ["node", "services/worker/dist/index.js"]

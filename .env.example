# Oprino Monorepo Environment Configuration Template
# COPY TO .env IN SERVICES/APPS AS NEEDED (NEVER COMMIT REAL SECRETS)

# Node Environment
NODE_ENV=development

# API Service
API_PORT=3000
API_HOST=127.0.0.1
API_PUBLIC_URL=http://localhost:3000

# Better Auth Secret (32+ chars random string)
BETTER_AUTH_SECRET=oprino_dev_secret_must_be_at_least_32_characters_long_for_security
BETTER_AUTH_URL=http://localhost:3000

# Database (PostgreSQL 18 + PostGIS)
DATABASE_URL=postgresql://oprino_admin:oprino_dev_password@localhost:5432/oprino_db

# Redis (BullMQ & Cache)
REDIS_URL=redis://localhost:6379

# Web Dashboard
NEXT_PUBLIC_API_URL=http://localhost:3000

{
  "openapi": "3.0.3",
  "info": {
    "title": "Oprino Architecture Validation API",
    "description": "OpenAPI contract spike validating Fastify Zod to Dart Dio codegen",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Opaque Session Token"
      }
    },
    "schemas": {}

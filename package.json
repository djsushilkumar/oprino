{
  "name": "oprino-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "generate": "turbo generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check-links": "node scripts/validate-doc-links.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "overrides": {
    "drizzle-orm": "0.40.0"
  }
}
